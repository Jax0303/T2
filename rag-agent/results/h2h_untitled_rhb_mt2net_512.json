{
  "experiment": "corpus scale: retrieve-then-dump vs retrieve cells",
  "env": {
    "seed": 42,
    "device": "NVIDIA GeForce RTX 3060 Ti",
    "torch": "2.12.1+cu130",
    "embed_model": "BAAI/bge-small-en-v1.5",
    "vector_backend": "faiss",
    "run_started_utc": "2026-08-23T11:01:32+00:00"
  },
  "population": {
    "name": "realhitbench , gold cells recovered by answer match, ambiguous dropped",
    "n": 243,
    "frozen": null
  },
  "corpus": {
    "dataset": "realhitbench",
    "split": "dev",
    "tables": 536,
    "cells": 148140
  },
  "budget_tokens": 512,
  "budget_tokenizer": "BAAI/bge-small-en-v1.5",
  "retriever": "dense",
  "reader": "local:Qwen/Qwen2.5-7B-Instruct",
  "reader_spec": "local:Qwen/Qwen2.5-7B-Instruct?quantization=4bit&dtype=float16",
  "answer_mode": "direct",
  "cell_scheme": "mt2net",
  "arms_run": [
    "flat",
    "cell"
  ],
  "cell_title": true,
  "arms": {
    "dump": "table index -> whole tables in rank order while they fit",
    "cell": "corpus-wide S2 cell index -> cells while they fit",
    "cascade": "top-1 table by table index, then its cells only",
    "cell2dump": "tables ranked by their best cell, dumped whole",
    "cellrow": "rows ranked by their best cell, emitted as rows",
    "row": "corpus-wide row-chunk index -> whole data rows",
    "flat": "corpus-wide cell index, LEAF labels only (ablation)",
    "capped": "like `cell` but at most 3 cells per table",
    "group": "same cells and same ranking as `cell`, but rendered grouped by table with the title stated ONCE -- the title is 29% of every S3 sentence and is what the gain comes from, so paying for it per table instead of per cell buys back budget at no information loss"
  },
