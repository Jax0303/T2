#!/bin/bash
# 표 2 의 기준선 행 — 리더가 필요해서 GPU 머신에서 돌린다 (T2 는 CUDA 없음).
#
# 검색 레그는 이미 끝났고 records 에 --dump-context 24 로 문맥이 실려 있으므로,
# 여기서 도는 것은 리더뿐이다. 조건·리더·채점기는 본 방법 행과 동일하게 두어야
# 표 2 안에서 행끼리 비교가 성립한다 (모집단이 다른 행끼리는 빼지 말 것 — TABLES.md
# 표 2 의 경고 참조).
set -e
cd "$(dirname "$0")/../.."
export PYTHONPATH=.
R=results/retrieval_accuracy

# ⚠️ 표 1 의 주 모집단은 2026-09-08 에 단일 셀 조회 n=991 로 바뀌었는데(CLAUDE.md §0.1)
# 표 2 는 아직 n=1,245 다. 두 표를 나란히 읽으려면 여기서도 같은 모집단으로 집계해야
# 한다 -- `analysis/accuracy_tables.py: primary_ids()` 가 그 질의 집합을 준다.
for tag in t_chunk1000 t_trag_hetero t_trag_hetero_tok t_tablerag_leaf t_tablerag_path \
           t_row_values t_rowcol_values t_row_hybrid t_table_hybrid t_mt2net_hybrid; do
  .venv/bin/python scripts/answer_accuracy.py \
      --records $R/${tag}_records.jsonl \
      --condition retrieved \
      --out $R/${tag}_answer_retrieved.json
done

# 유도로 채워 둔 oracle 행의 확인 (analysis/oracle_row.py 가 records 에서 유도한 값과
# 일치해야 한다 — 어긋나면 리더가 결정적이라는 전제가 깨진 것이다).
.venv/bin/python scripts/answer_accuracy.py \
    --records $R/t_s3c_hybrid_records.jsonl \
    --condition oracle \
    --out $R/t_s3c_hybrid_answer_oracle.json

.venv/bin/python analysis/accuracy_tables.py > $R/TABLES.md
