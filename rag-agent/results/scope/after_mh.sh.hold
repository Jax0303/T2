#!/bin/bash
cd /home/user/T2-1/rag-agent
until grep -q "MH_DONE\|Traceback" results/scope/after_scope.log; do sleep 30; done
COMMON="--embed-model models/bge-base-scope-p2 --alpha 0.8 --title-mode page --gold 1 --ks 10 --context-mode scope --answer-mode cot"
for sp in dev test; do
  echo "=== E5 arith $sp ==="
  PYTHONPATH=.:scripts:analysis .venv/bin/python analysis/retrieved_answer_em.py $COMMON --split $sp --population hitab_${sp}_corpus_arith \
    --gold-file results/audit2/hitab_${sp}_corpus_arith_gold.json --out results/stage3/e5_arith_${sp}.jsonl
  echo "EXIT $?"
done
echo E5_DONE
